HOST=0.0.0.0
PORT=3001
# Pi controller/RTSP (private; never use VITE_ variables for these secrets).
# Uncomment these only when all private Pi settings are configured, or use deploy.py.
# PI_CONTROL_URL=http://facepi.local:8765
# PI_RTSP_URL=rtsp://studentattention:REPLACE_WITH_PRIVATE_PASSWORD@facepi.local:8554/camera
# Optional verified Pi IPv4 when a hotspot cannot resolve .local; update if DHCP changes.
# PI_HOST_FALLBACK=192.168.1.100
# Same private token as Raspberry_pi_4/.env, at least 32 characters.
PI_TOKEN=
AI_DEVICE=cpu
AI_THREADS=1
AI_OPENCV_THREADS=1
# PyTorch GPU only. CPU uses fixed 640 ONNX input.
AI_SCENE_IMGSZ=640
MIN_BEHAVIOR_FACE_PX=40
# Camera-facing direction, used immediately without a per-person calibration wait.
AI_CAMERA_YAW_DEG=0
# 1 shows raw library diagnostics; 0 keeps readable operation events.
AI_DEBUG=0

