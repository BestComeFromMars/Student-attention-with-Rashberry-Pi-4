{
  "name": "student-attention-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prestart": "node scripts/prestart.mjs",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "build": "node ../scripts/build.mjs backend",
    "pretest": "npm run build",
    "test": "vitest run && node scripts/test-ai.mjs",
    "setup:model": "node scripts/setup-ai.mjs",
    "setup:legacy-facemesh": "node scripts/setup-model.mjs",
    "setup:ai": "node scripts/setup-ai.mjs",
    "setup:actions": "node scripts/setup-actions.mjs",
    "setup:classroom-actions": "node scripts/setup-classroom-actions.mjs",
    "verify:classroom-actions": "node scripts/verify-classroom-actions.mjs",
    "test:action-stability": "npm run build && node scripts/check-action-stability.mjs --seconds 900",
    "demo:actions": "npm run build && node scripts/run-action-demo.mjs",
    "verify:model": "npm run build && node scripts/verify-model.mjs",
    "verify:observations": "npm run build && node scripts/verify-observations.mjs",
    "verify:faces": "npm run build && node scripts/verify-faces.mjs",
    "verify:tracking": "npm run build && node scripts/verify-tracking.mjs",
    "verify:camera-recovery": "npm run build && node scripts/check-camera-recovery.mjs",
    "verify:fast-motion": "npm run build && node scripts/check-fast-motion.mjs",
    "verify:objects": "npm run build && node scripts/verify-object-tracking.mjs",
    "verify:ghosts": "npm run build && node scripts/verify-ghosts.mjs",
    "verify:poses": "npm run build && node scripts/verify-poses.mjs",
    "verify:lowlight": "npm run build && node scripts/verify-lowlight.mjs",
    "verify:startup": "npm run build && node scripts/verify-startup.mjs",
    "export:videos": "npm run build && node scripts/export-ui-videos.mjs"
  },
  "dependencies": { "@tensorflow-models/face-landmarks-detection": "1.0.6", "@tensorflow/tfjs": "4.22.0", "@tensorflow/tfjs-backend-wasm": "4.22.0", "express": "5.3.0", "sharp": "0.35.5", "tar": "7.5.22" },
  "devDependencies": { "@types/express": "5.0.6", "@types/node": "^22.19.0", "typescript": "5.9.3", "vitest": "5.1.0" }
}
